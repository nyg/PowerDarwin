#!/bin/bash
set -uo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
plists="$root/manifest/plists"
list="$root/manifest/9L30-roots.tsv"
used="$root/manifest/9L30-roots-used.tsv"
sums="$root/manifest/9L30-roots.sha256"
export wayback_fetch="$root/scripts/wayback-fetch"
export dest="$root/roots"
export site="src.macosforge.org/Roots"
mkdir -p "$dest"

sha256() { if command -v shasum > /dev/null; then shasum -a 256 "$@"; else sha256sum "$@"; fi; }

chain=()
build=9L30
while [[ -n $build ]]; do
   chain+=("$build")
   build=$(sed -nE 's/^[[:space:]]*inherits = ([0-9A-Z]+);/\1/p' "$plists/$build.plist")
done

for build in "${chain[@]}"; do
   mkdir -p "$dest/$build"
   [[ -s $dest/$build/.listing ]] && continue
   index="$dest/$build/.index.html"
   "$wayback_fetch" "$index" "https://web.archive.org/web/2011/http://$site/$build/" || { echo "no listing for $build" >&2; exit 1; }
   grep -oE 'href="[^"]+\.tar\.gz"' "$index" | sed -E 's|.*/||; s|^href="||; s|"$||' | sort -u > "$dest/$build/.listing"
   rm -f "$index"
   [[ -s $dest/$build/.listing ]] || { echo "no listing for $build" >&2; exit 1; }
   echo "$build: $(wc -l < "$dest/$build/.listing" | tr -d ' ') files listed"
done

find_build() {
   local file=$1 start=$2 origin=0 i
   for i in "${!chain[@]}"; do [[ ${chain[$i]} == "$start" ]] && origin=$i; done
   for ((i = origin; i >= 0; i--)); do
      grep -qx "$file" "$dest/${chain[$i]}/.listing" && { echo "${chain[$i]}"; return; }
   done
   for ((i = origin + 1; i < ${#chain[@]}; i++)); do
      grep -qx "$file" "$dest/${chain[$i]}/.listing" && { echo "${chain[$i]}"; return; }
   done
}

position() {
   local i
   for i in "${!chain[@]}"; do [[ ${chain[$i]} == "$1" ]] && echo "$i"; done
}

queue=$(mktemp)
new_used=$(mktemp)
while IFS=$'\t' read -r name version origin _; do
   rootbuild=$(find_build "$name.root.tar.gz" "$origin")
   hdrsbuild=$(find_build "$name.hdrs.tar.gz" "$origin")
   [[ -n $rootbuild ]] && echo "$rootbuild $name.root.tar.gz" >> "$queue"
   [[ -n $hdrsbuild ]] && echo "$hdrsbuild $name.hdrs.tar.gz" >> "$queue"
   if [[ -z $rootbuild ]]; then status=none
   elif (( $(position "$rootbuild") <= $(position "$origin") )); then status=exact
   else status=older
   fi
   printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$version" "$origin" "${rootbuild:--}" "$status" "${hdrsbuild:--}" >> "$new_used"
done < "$list"
mv "$new_used" "$used"

fetch() {
   local build=$1 file=$2
   local target="$dest/$build/$file"
   [[ -s $target ]] && return 0
   sleep 2
   if "$wayback_fetch" "$target.part" "https://web.archive.org/web/2011id_/http://$site/$build/$file" \
      && gzip -t "$target.part" 2>/dev/null; then
      mv "$target.part" "$target"
   else
      rm -f "$target.part"
      echo "failed: $build/$file" >&2
      return 1
   fi
}
export -f fetch

failed=0
sort -u "$queue" | xargs -P 2 -n 2 bash -c 'fetch "$0" "$1"' || failed=1
rm -f "$queue"

cd "$dest"
touch "$sums"
[[ -s $sums ]] && { sha256 -c --quiet "$sums" || failed=1; }
added=0
while read -r file; do
   grep -q "  $file\$" "$sums" && continue
   sha256 "$file" >> "$sums"
   added=$((added + 1))
done < <(find . -name '*.tar.gz' | sed 's|^\./||' | sort)
LC_ALL=C sort -k2 -o "$sums" "$sums"
echo "$(wc -l < "$sums" | tr -d ' ') hashes in manifest/9L30-roots.sha256, $added new"
cut -f5 "$used" | sort | uniq -c
exit $failed
