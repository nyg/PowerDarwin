#!/bin/bash
set -uo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
manifest="$root/manifest/9L30.tsv"
sums="$root/manifest/9L30.sha256"
export dest="$root/sources"
record=
[[ ${1:-} == --record ]] && { record=1; shift; }
mkdir -p "$dest"

fetch() {
   local project=$1 version=$2 source=$3 url
   local file="$dest/$project-$version.tar.gz"
   [[ -s $file ]] && return 0
   case $source in
      github) url="https://github.com/apple-oss-distributions/$project/archive/refs/tags/$project-$version.tar.gz" ;;
      archive) url="https://web.archive.org/web/2012id_/http://www.opensource.apple.com/tarballs/$project/$project-$version.tar.gz" ;;
   esac
   if curl -fsSL --retry 3 -o "$file.part" "$url"; then
      mv "$file.part" "$file"
   else
      rm -f "$file.part"
      echo "failed: $project-$version" >&2
   fi
}
export -f fetch

if [[ $# -gt 0 ]]; then
   for project in "$@"; do
      awk -F'\t' -v p="$project" '$1 == p { print $1, $2, $3 }' "$manifest"
   done
else
   awk -F'\t' 'NR > 1 && $3 == "github" { print $1, $2, $3 }' "$manifest"
fi | xargs -P 6 -n 3 bash -c 'fetch "$0" "$1" "$2"'

cd "$dest"
touch "$sums"
unrecorded=0
for file in *.tar.gz; do
   awk -v f="$file" '$2 == f { found = 1 } END { exit !found }' "$sums" && continue
   if [[ -n $record ]]; then
      shasum -a 256 "$file" >> "$sums"
      echo "recorded the hash of $file"
   else
      echo "no recorded hash: $file (fetch-sources --record adds it to manifest/9L30.sha256)" >&2
      unrecorded=1
   fi
done
shasum -a 256 -c --quiet "$sums" || exit 1
exit $unrecorded
