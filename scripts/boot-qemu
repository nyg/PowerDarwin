#!/bin/bash
set -euo pipefail

image=${1:?usage: boot-qemu <raw disk image> [boot-args] [CD image]}
boot_args=${2:--v -s}
cd_args=()
[[ -n ${3:-} ]] && cd_args=(-drive file="$3",format=raw,media=cdrom,index=2)
monitor=${QEMU_MONITOR:-/tmp/darwin9-qemu.sock}
ssh_port=${QEMU_SSH_PORT:-2222}

exec qemu-system-ppc \
   -M mac99,via=pmu \
   -m 1024 \
   -drive file="$image",format=raw,media=disk \
   ${cd_args[@]+"${cd_args[@]}"} \
   -boot c \
   -prom-env "boot-args=$boot_args" \
   -g 1024x768x32 \
   -nic user,model=sungem,hostfwd=tcp:127.0.0.1:"$ssh_port"-:22 \
   -monitor unix:"$monitor",server,nowait \
   -serial file:"${image%.*}.serial.log"
