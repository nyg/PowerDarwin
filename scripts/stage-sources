#!/bin/bash
set -euo pipefail

usage="usage: stage-sources <ssh host> <project>[=<version>]...
       stage-sources --here=<build folder> <project>[=<version>]..."

target=${1:?$usage}
shift
here=
[[ $target == --here=* ]] && here=${target#--here=}
root=$(cd "$(dirname "$0")/.." && pwd)
stage=$(mktemp -d /tmp/stage-sources.XXXXXX)
trap 'rm -rf "$stage"' EXIT

for arg in "$@"; do
   project=${arg%%=*}
   version=${arg#"$project"}
   version=${version#=}
   [[ -n $version ]] || version=$(awk -F'\t' -v p="$project" '$1 == p { print $2 }' "$root/manifest/9L30.tsv")
   [[ -n $version ]] || { echo "not in manifest: $project" >&2; exit 1; }
   tarball="$root/sources/$project-$version.tar.gz"
   if [[ -f $tarball ]]; then
      unpacked="$stage/.unpack"
      mkdir "$unpacked"
      tar -xzf "$tarball" -C "$unpacked"
      top=$(ls "$unpacked")
      [[ $(echo "$top" | wc -l) -eq 1 && -d $unpacked/$top ]] || { echo "not one top folder: $tarball" >&2; exit 1; }
      mv "$unpacked/$top" "$stage/$project-$version"
      rmdir "$unpacked"
   elif [[ -d $root/replacements/$project ]]; then
      cp -R "$root/replacements/$project" "$stage/$project-$version"
   else
      echo "no source tarball: $tarball" >&2
      exit 1
   fi
   echo "$project-$version"
   for patch in "$root/patches/$project-$version"/*.patch; do
      [[ -e $patch ]] || continue
      patch -s -p1 -d "$stage/$project-$version" < "$patch"
      echo "   patched with $(basename "$patch")"
   done
   touch_list="$root/patches/$project-$version/touch"
   if [[ -f $touch_list ]]; then
      while read -r file; do
         touch "$stage/$project-$version/$file"
         echo "   touched $file"
      done < "$touch_list"
   fi
done

if [[ -n $here ]]; then
   mkdir -p "$here/Sources"
   for folder in "$stage"/*; do
      rm -rf "$here/Sources/${folder##*/}"
      mv "$folder" "$here/Sources/"
   done
else
   COPYFILE_DISABLE=1 tar -cf - --no-mac-metadata -C "$stage" . | ssh "$target" "tar -xf - -C 9L30/Sources"
fi
