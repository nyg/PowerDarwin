#!/bin/sh
set -e

usage="usage: make-test-image [--folder=<build folder>] [--ntp-server=<host>] [--time-zone=<zone>]"
folder=~/9L30
ntp_server=$(sed -n 's/^server[[:space:]]*\([^[:space:]]*\).*/\1/p' /etc/ntp.conf 2>/dev/null | head -1)
[ -n "$ntp_server" ] || ntp_server=time.apple.com
zone=$(readlink /etc/localtime || true)
zone=${zone#/usr/share/zoneinfo/}
for arg; do
   case $arg in
      --folder=*) folder=${arg#--folder=} ;;
      --ntp-server=*) ntp_server=${arg#--ntp-server=} ;;
      --time-zone=*) zone=${arg#--time-zone=} ;;
      *) echo "$usage" >&2; exit 1 ;;
   esac
done
roots=$folder/Roots
sources=$folder/Sources
image=/private/var/tmp/PowerDarwin
mount=/Volumes/PowerDarwin-image
root_hash=$folder/root-password.hash
userland_projects="Libm dyld bash ncurses libiconv libgcc bsm libutil libedit file_cmds shell_cmds diskdev_cmds IOKitUser ICU objc4 autozone libstdcxx zlib Libsystem launchd files pam pam_modules system_cmds text_cmds CF Security configd configd_plugins configd_executables notify DiskArbitration libresolv ipsec network_cmds tcp_wrappers OpenSSL bootp Kerberos OpenSSH tcl SQLite passwordserver_sasl passwordserver_saslkerberos DSPasswordServerFramework LDAPFramework DirectoryService DirectoryServiceDaemon grep less adv_cmds syslog ntp vim SmartCardServices SecurityTokend securityd IOKitTools BootCache hfs bless isoutil msdosfs cddafs OpenPlay Csu SystemStubs cctools ld64 gcc gcc_42 gcc_select gnumake perl expat libffi python ruby samba"
header_projects="Libc_headers architecture Librpcsvc Libsyscall Libinfo Libm libdyld launchd_libs CommonCrypto removefile copyfile Libnotify bsm mDNSResponder cctools_ofiles objc4"
kext_projects="IOPCIFamily IOStorageFamily IOATAFamily AppleMacRiscPCI AppleMacRISC2PE AppleKeyLargo AppleMPIC AppleCore99NVRAM AppleVIA AppleGPIO KeyLargoATA AppleFileSystemDriver IOI2CFamily IOHIDFamily IOUSBFamily IOATAPIProtocolTransport IOCDStorageFamily IODVDStorageFamily IOBDStorageFamily AppleMediaBay AppleKauaiATA AppleK2SATARoot AppleK2SATA IOGraphics AppleMacRISC4PE AppleFlashNVRAM AppleI2C IOATABlockStorage IONetworkingFamily AppleGMACEthernet OpenSMU OpenPMU IOSCSIArchitectureModelFamily IOUSBMassStorageClass IOAudioFamily AppleI2S AppleOnboardAudio OpenOnyx OpenRadeonPM IOFireWireFamily IOFireWireSBP2 IOFireWireSerialBusProtocolTransport OpenFWOHCI"

latest() { ls -d $roots/$1/$1-*~* 2>/dev/null | sort -t~ -k2 -n | tail -1; }

for project in $userland_projects xnu kext_tools $header_projects $kext_projects BootX; do
   [ -n "$(latest $project)" ] || { echo "no Root of $project in $roots" >&2; exit 1; }
done

rm -f $image.dmg $image.cdr $image.cdr.gz
hdiutil create -size 1600m -layout SPUD -fs HFS+J -volname PowerDarwin $image.dmg
hdiutil attach -owners on -nobrowse -mountpoint $mount $image.dmg

for project in $userland_projects; do
   sudo ditto "$(latest $project)" $mount
done
sudo ditto "$(latest xnu)" $mount
sudo ditto "$(latest kext_tools)" $mount
for project in $header_projects; do
   sudo ditto "$(latest $project)/usr/include" $mount/usr/include
done
carbon=$(mktemp -d /tmp/carbonheaders.XXXXXX)
make -s -C $sources/CarbonHeaders-18.1 install DSTROOT=$carbon KERNEL_SYLINKS= DO_CARBON_CORE_FILES=install_carbon_core_headers
sudo ditto $carbon/usr/include $mount/usr/include
core_services=$mount/System/Library/Frameworks/CoreServices.framework
carbon_core=$core_services/Versions/A/Frameworks/CarbonCore.framework
sudo mkdir -p $core_services/Versions/A/Headers $carbon_core/Versions/A/Headers
sudo ln -s A $core_services/Versions/Current
sudo ln -s Versions/Current/Headers $core_services/Headers
sudo ln -s Versions/Current/Frameworks $core_services/Frameworks
sudo ln -s A $carbon_core/Versions/Current
sudo ln -s Versions/Current/Headers $carbon_core/Headers
sudo install -m 644 $carbon/usr/include/MacTypes.h $carbon_core/Versions/A/Headers/MacTypes.h
rm -rf $carbon
sudo rm -f $mount/mach_kernel.ctfsys
sudo rm -rf $mount/usr/local/lib/SystemConfiguration
sudo rm -rf $mount/AppleInternal
sudo rm -f $mount/System/Library/LaunchDaemons/com.apple.DirectoryServicesInstallDaemon.plist
sudo rm -rf $mount/System/Library/Extensions/CM4040.kext $mount/System/Library/Extensions/CRYPTOCardPCCard.kext $mount/System/Library/Extensions/SCR24X_Apple_Driver.kext
sudo rm -rf $mount/usr/libexec/SmartCardServices/drivers/*.bundle "$mount/Library/Application Support/Mozilla"
sudo rm -f $mount/usr/lib/libncurses.5.dylib
sudo rm -f $mount/usr/share/misc/bootblockdata
sudo rm -rf $mount/Developer
sudo rm -f $mount/System/Library/Frameworks/Python.framework/Versions/2.5/lib/python2.5/distutils/command/wininst-*.exe
printf '#!/bin/sh\nexit 0\n' | sudo tee $mount/usr/bin/dsymutil > /dev/null
sudo chmod 755 $mount/usr/bin/dsymutil

for project in $kext_projects; do
   sudo ditto "$(latest $project)/System/Library/Extensions" $mount/System/Library/Extensions
done
sudo rm -rf $mount/System/Library/Extensions/IOAudioFamily.kext/Contents/PlugIns/AOAHALPlugin.bundle
sudo rm -rf $mount/System/Library/Extensions/AppleOnboardAudio.kext/Contents/PlugIns/AppleOnyxAudio.kext $mount/System/Library/Extensions/AppleOnboardAudio.kext/Contents/PlugIns/AppleToonieAudio.kext
sudo ditto "$(latest BootX)" $mount
sudo mkdir -p $mount/System/Library/CoreServices

sudo mkdir -p $mount/Volumes $mount/Library/Preferences/SystemConfiguration
sudo install -m 644 $sources/system_cmds-433.8/getty.tproj/com.apple.getty.plist $mount/System/Library/LaunchDaemons/
sudo install -m 644 $sources/launchd-258.25/launchd/src/rc.common $sources/launchd-258.25/launchd/src/hostconfig $mount/private/etc/
sudo sed -i '' "/<key>Disabled<\/key>/{n;s|<true/>|<false/>|;}" $mount/System/Library/LaunchDaemons/ssh.plist
[ -f "$mount/usr/share/zoneinfo/$zone" ] || zone=UTC
sudo ln -sfh "/usr/share/zoneinfo/$zone" $mount/private/etc/localtime
echo "server $ntp_server" | sudo tee $mount/private/etc/ntp.conf > /dev/null
sudo mkdir -p $mount/private/var/db/dyld/shared_region_roots
printf '%s\n' /bin/sh /bin/bash /usr/sbin/configd /usr/sbin/DirectoryService /usr/sbin/sshd | sudo tee $mount/private/var/db/dyld/shared_region_roots/Darwin.paths > /dev/null
if [ -f $root_hash ]; then
   sudo sed -i '' "s|^root:\*:|root:$(cat $root_hash):|" $mount/private/etc/master.passwd
   sudo sed -i '' "/<key>passwd<\/key>/{n;n;s|<string>\*</string>|<string>$(cat $root_hash)</string>|;}" $mount/private/var/db/dslocal/nodes/Default/users/root.plist
fi
sudo tee $mount/System/Library/CoreServices/SystemVersion.plist > /dev/null <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ProductBuildVersion</key>
	<string>9L30</string>
	<key>ProductName</key>
	<string>Darwin</string>
	<key>ProductVersion</key>
	<string>9.8</string>
</dict>
</plist>
EOF
sudo mkdir -p -m 1777 $mount/Users/Shared
sudo tee $mount/private/etc/smb.conf > /dev/null <<EOF
[global]
	workgroup = WORKGROUP
	server string = Darwin 9.8
	security = user
	passdb backend = tdbsam
	opendirectory = no
	use spnego = no
	unix password sync = no
	load printers = no
	printcap name = /dev/null
	disable spoolss = yes
	wide links = no

[Shared]
	path = /Users/Shared
	read only = no
EOF
sudo /usr/libexec/PlistBuddy -c "Set :Disabled false" $mount/System/Library/LaunchDaemons/smbd.plist
sudo rm -f $mount/System/Library/LaunchDaemons/com.apple.smb.server.preferences.plist
sudo tee $mount/Library/Preferences/SystemConfiguration/autodiskmount.plist > /dev/null <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AutomountDisksWithoutUserLogin</key>
	<true/>
</dict>
</plist>
EOF
sudo tee $mount/Library/Preferences/SystemConfiguration/com.apple.Boot.plist > /dev/null <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Kernel</key>
	<string>mach_kernel</string>
	<key>Kernel Flags</key>
	<string></string>
</dict>
</plist>
EOF

sudo "$(latest kext_tools)/usr/sbin/kextcache" -a ppc -l -m $mount/System/Library/Extensions.mkext $mount/System/Library/Extensions
sudo bless --folder $mount/System/Library/CoreServices --bootinfo $mount/usr/standalone/ppc/bootx.bootinfo
/Developer/Tools/GetFileInfo $mount/System/Library/CoreServices/BootX | grep -E 'type|creator'
bless --info $mount | head -3
df -h $mount | tail -1

hdiutil detach $mount
hdiutil convert $image.dmg -format UDTO -o $image
gzip -1 -c $image.cdr > $image.cdr.gz
ls -l $image.cdr $image.cdr.gz
