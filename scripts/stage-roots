#!/bin/bash
set -euo pipefail

usage="usage: stage-roots <ssh host> [build folder on host]
       stage-roots --here=<build folder>"

target=${1:?$usage}
folder=${2:-9L30}
root=$(cd "$(dirname "$0")/.." && pwd)
used="$root/manifest/9L30-roots-used.tsv"

roots_used() {
   while IFS=$'\t' read -r name _ _ rootbuild _ hdrsbuild; do
      [[ $rootbuild != - ]] && echo "$rootbuild/$name.root.tar.gz"
      [[ $hdrsbuild != - ]] && echo "$hdrsbuild/$name.hdrs.tar.gz"
   done < "$used"
}

if [[ $target == --here=* ]]; then
   cache="${target#--here=}/Roots/.DownloadCache"
   mkdir -p "$cache"
   missing=0
   while read -r file; do
      if [[ -f $root/roots/$file ]]; then
         cp -p "$root/roots/$file" "$cache/"
      else
         echo "missing: $root/roots/$file" >&2
         missing=1
      fi
   done < <(roots_used)
   ls "$cache" | wc -l
   exit $missing
fi

stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
while read -r file; do
   ln -s "$root/roots/$file" "$stage/${file##*/}"
done < <(roots_used)

find -L "$stage" -type l -exec sh -c 'echo "missing: $(readlink "$1")" >&2' _ {} \;
COPYFILE_DISABLE=1 tar -chf - -C "$stage" . | ssh "$target" "mkdir -p $folder/Roots/.DownloadCache && tar -xf - -C $folder/Roots/.DownloadCache"
ssh "$target" "ls $folder/Roots/.DownloadCache | wc -l"
