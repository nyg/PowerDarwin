#!/bin/sh
set -e

src=$(cd "$(dirname "$0")" && pwd)
out=${1:?usage: build <output folder>}
arches="-arch ppc -arch ppc64 -arch i386 -arch x86_64"

mkdir -p "$out/usr/local/lib/system" "$out/usr/include"
cp "$src/sandbox.h" "$out/usr/include/sandbox.h"

for variant in "" _debug _profile; do
   case $variant in
      "") flags="-Os" ;;
      _debug) flags="-g" ;;
      _profile) flags="-Os -pg" ;;
   esac
   cc -c $arches $flags -Wall -Werror -o "$out/sandbox$variant.o" "$src/sandbox.c"
   libtool -static -o "$out/usr/local/lib/system/libsandbox$variant.a" "$out/sandbox$variant.o"
   rm "$out/sandbox$variant.o"
done
