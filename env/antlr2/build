#!/bin/sh
set -e

top=${1:?usage: build-antlr2 <folder made by generate>}
arches="-arch ppc -arch ppc64 -arch i386 -arch x86_64"
objects=$top/src/antlr2/obj

mkdir -p "$objects" "$top/usr/local/lib"
for source in "$top"/src/antlr2/*.cpp; do
   c++ -c $arches -Os -I"$top/usr/local/include" -o "$objects/$(basename "$source" .cpp).o" "$source"
done
libtool -static -o "$top/usr/local/lib/libantlr2c++.a" "$objects"/*.o
rm -rf "$objects"
