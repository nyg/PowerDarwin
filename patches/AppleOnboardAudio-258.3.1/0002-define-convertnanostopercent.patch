+
+
+static double UInt64ToDouble (UInt64 inValue)
+{
+	return (double)(UInt32)(inValue >> 32) * 4294967296.0 + (double)(UInt32)inValue;
 }
 
+void convertNanosToPercent (UInt64 inNumerator, UInt64 inDenominator, float * percent)
+{
+	*percent = inDenominator ? (float)(UInt64ToDouble (inNumerator) * 100.0 / UInt64ToDouble (inDenominator)) : 0.0f;
+}
